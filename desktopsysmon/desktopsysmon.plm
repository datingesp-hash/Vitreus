language 0.1
import "../palette.plm"

//  The desktop system monitor: glass channels and writing on the bottom layer (above the wallpaper, under every window) with the processor, the memory, the
//  graphics card and the network, a smaller cousin of Settings > System monitor. Its numbers come from `vitreus-sysmon`, which runs only while the
//  card is shown. Its tint is the shell's (`tint` of palette.plm, which Iris keeps), the same as the clock's and the bar's glass.
//
//  Turn it on or off with   pleamar --say desktopsysmon "fact shown true"   (or false).
//  Its settings are kept in desktopsysmon.json, in ~/.local/share/pleamar/desktopsysmon (see desktopsysmon.luau).

scene DesktopSysmon {
    //  1 x 1 and empty, one on each monitor: its copies report the monitors' names (`screen.K.name`) for where `hyprctl` does not answer, and keep the
    //  scene's rules running. The card itself is `surface face` below: one surface, on its own monitor (`scr`), not a full-screen copy on every monitor
    //  (~27 MB on the card each, drawing nothing but on one of them). See widget_place.luau.
    surface { size: 1, 1; anchor: top_left; margin: 0; level: background; screens: each max 4; reserve: -1; keyboard: none }
    //  (15 frames a second at rest: the graph glides on a 4 s spring after every sample, so it never stops, and at the screen's pace that was a full-screen layer
    //  painted sixty times a second all day on every monitor. Smooth enough for a graph; full pace while it is dragged or put back.)

    permissions {
        services: "files", "files.write"
        run: "vitreus-sysmon", "sh", "pleamar", "hyprctl", "socat", "printenv"
    }

    fact where: top_left | top | top_right | left | center | right | bottom_left | bottom | bottom_right = bottom_right
    fact gx = -1           // the cell of its top left corner, 0 to 15 (-1: not chosen yet, `where` says)
    fact gy = -1           // and the row, 0 to 8
    fact edit = false      // Edit, from the desktop editor (desktopedit/): the widget shows the cells it takes and can be dragged to others
    fact g0x = 0           // while it is dragged: the cell it was at when it was pressed
    fact g0y = 0
    fact dragging = false
    text mon_name = ""     // the name of the monitor that shows the card (Settings > Widgets sets it; the logic keeps it)
    text scr = ""          // the monitor its surface is on: the logic sets it (widget_place.luau), the same as `mon_name` once the monitors are known
    //  Whether there is a monitor behind each edge of its own (the logic works it out), and its name: in Edit mode the widget goes over to it when it
    //  is pushed against that edge and held there a moment (`es`, which the logic watches).
    fact nb_l = false
    fact nb_r = false
    fact nb_t = false
    fact nb_b = false
    text nbn_l = ""
    text nbn_r = ""
    text nbn_t = ""
    text nbn_b = ""
    fact es = 0            // pushed against an edge with a monitor behind it: 1 left, 2 right, 3 top, 4 bottom; 0 none
    fact pcx = 0           // while it is dragged: the card's centre when it was pressed, in its surface
    fact pcy = 0
    fact dcx = 0           // and where that centre is now
    fact dcy = 0
    fact zpx = 0           // while it is dragged: where the card was when it was pressed (the zone stays there)
    fact zpy = 0
    fact shown = false     // the logic sets it from desktopsysmon.json (so that `sh` follows it from nothing)
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full

    fact cpu_f = 0         // the processor's load, 0..1
    fact mem_f = 0
    fact gpu_on = false    // a graphics card that reports itself
    fact gpu_f = 0
    text host = ""
    text up = ""
    text cpu_txt = "0%"
    text cpu_meta = ""     // 3.2 GHz · 46°C
    text mem_txt = "0%"
    text mem_meta = ""     // 2.5 of 31 GB
    text gpu_txt = "0%"
    text gpu_meta = ""
    text rx_txt = ""
    text tx_txt = ""
    fact aur_on = false    // the AUR has been asked (once an hour, see the logic) and answered
    text aur_txt = ""      // "3 AUR updates", or "AUR up to date"
    model net_h max 120 { rx: number; tx: number }    // the last minute of the network, smoothed to two columns a second, each against the biggest in view
    fact net_step = 0                                  // one more with every sample: the graph slides by one sample
    //  How far the graph has slid, in samples: a slow spring chasing the count of samples. They arrive about once a second but never exactly,
    //  and a slide that took exactly a second (on a clock of the scene's own) ended early or late and paused before each sample. A spring that takes
    //  longer than the gap between two samples is still moving when the next one arrives, so it glides on at an even pace, and it only settles
    //  (and the scene rests) when the samples stop. `net_lag` is what is still to slide (about 1.5 at rest, 1 of it under the clip's edge); more than four samples behind (the card shown again
    //  after a while) it jumps instead of racing to catch up.
    prop net_glide = 0 ~4000ms
    let net_lag = net_step - net_glide
    follow net_glide = net_step
    on change net_step while net_lag > 4 { net_glide: net_step - 2 ~0ms }

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    shader paper = file "../paper.wgsl"
    fact obs = false        // Vitreus has its glass off: the card is flat obsidian (Vitreus says so with `fact obs true`)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    fact look = 0           // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU; the last two draw the card as plastic, like the bar (a body with an outline and a hard shadow)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    prop mk = 0 ~calm
    follow mk = if(look == 4, 1, 0)         // Milkbox: one pale raised material, no outline, a white light up and left and a soft shade down and right
    prop pxk = 0 ~calm
    follow pxk = if(look == 5, 1, 0)        // Proxy: a flat dark plate with a thin pale outline and a hard offset edge
    prop ppk = 0 ~calm
    prop dd = 0 ~calm
    follow dd = if(look == 7, 1, 0)         // Doodle: a cream plate with a thick black outline
    follow ppk = if(look == 6, 1, 0)       // Paper: a worn sheet of cream paper, taped down (paper.wgsl)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    let tx = mix(wink, ink, pl)         // the writing: light over glass, dark over plastic
    prop cpu_p = 0 ~calm
    prop mem_p = 0 ~calm
    prop gpu_p = 0 ~calm
    follow cpu_p = cpu_f
    follow mem_p = mem_f
    follow gpu_p = gpu_f

    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))

    //  Three rings (the processor, the memory, the graphics card: two when there is no card that reports itself) and the last minute of the network under
    //  them. The rings' tracks and the graph's line are channels of one body of glass (like the clock's digits); what fills them and the writing float over the
    //  wallpaper, with a little shadow to read by.
    let g0 = if(gpu_on, 85, 135)
    let g1 = if(gpu_on, 200, 265)
    let g2 = 315
    //  The desktop is a grid of 16 columns and 9 rows, inside a 40 px margin; the settings put a widget on it by the cell of its top left corner (`gx`, `gy`) and it
    //  takes as many cells as it needs (`cfw`, `cfh`, which Settings > Widgets asks for). Against an edge of the grid it sits against that edge, between them it is centred in its cells.
    //  `gx` and `gy` below 0 are an older settings file: it is put where `where` says (one of the nine places, which is what the cells are made of).
    //  The room the bar's frame takes round the screen (Vitreus tells it: `room_*`, in pixels, 0 when the bar is not a frame), which the grid stays out of, so a widget cannot be put under the bar.
    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    let gnx = 28           // the grid: 28 columns and 16 rows (it used to be 16 x 9), from the bar's frame (the `room_*`) plus a 16 px margin
    let gny = 16
    let gm = 16
    let gl = gm + room_l
    let gt = gm + room_t
    let gr = gm + room_r
    let gb = gm + room_b
    let scw = face.width       // what its monitor measures (its surface is the whole of it)
    let sch = face.height
    let gw = (scw - gl - gr) / gnx
    let gh = (sch - gt - gb) / gny
    let fw = clamp(ceil(364 / gw), 1, gnx)
    let fh = clamp(ceil(230 / gh), 1, gny)
    let isl = if(where == top_left or where == left or where == bottom_left, 1, 0)
    let isr = if(where == top_right or where == right or where == bottom_right, 1, 0)
    let ist = if(where == top_left or where == top or where == top_right, 1, 0)
    let isb = if(where == bottom_left or where == bottom or where == bottom_right, 1, 0)
    let ex0 = clamp(if(gx < 0, if(isl > 0.5, 0, if(isr > 0.5, gnx - fw, (gnx - fw) / 2)), gx), 0, gnx - fw)
    let ey0 = clamp(if(gy < 0, if(ist > 0.5, 0, if(isb > 0.5, gny - fh, (gny - fh) / 2)), gy), 0, gny - fh)
    //  In Edit mode what is drawn follows the cell with a spring (`erx`, `ery`); otherwise it is the cell.
    prop erx = 0 ~quick
    prop ery = 0 ~quick
    follow erx = if(gx < 0, ex0, gx)      // (one for all the copies, so it must not depend on this monitor's size: `ex` clamps it)
    //  Settings > Theme > Pin widgets: while a theme puts the widgets back (`glide`, said by Vitreus), what is drawn slides to its new cell on a slower
    //  spring instead of jumping to it.
    fact glide = false
    prop glp = 0 ~0ms                    // (at once: the slower spring is already where the widget is, so taking it over shows nothing)
    follow glp = if(glide, 1, 0)
    prop gsx = 0 ~gentle
    prop gsy = 0 ~gentle
    follow gsx = if(gx < 0, ex0, gx)
    follow gsy = if(gy < 0, ey0, gy)
    follow ery = if(gy < 0, ey0, gy)
    let ex = clamp(mix(mix(ex0, erx, edp), gsx, glp), 0, gnx - fw)
    let ey = clamp(mix(mix(ey0, ery, edp), gsy, glp), 0, gny - fh)
    //  Where the card's top left corner is: against the grid's edge, or in the middle of its cells, and in between it moves from one to the other.
    //  What is drawn is 340 wide from x 30 and about 210 tall from y 8 inside the card's 400 x 280, so against an edge of the grid it is that, and not the card, that touches the margin.
    let cxm = gl + (ex + fw / 2) * gw - 200
    let cym = gt + (ey + fh / 2) * gh - 113
    let cx0 = cxm + (gl - 15 - cxm) * clamp(1 - ex, 0, 1) + (scw - gr - 385 - cxm) * clamp(ex + fw - (gnx - 1), 0, 1)
    let cy0 = cym + (gt + 5 - cym) * clamp(1 - ey, 0, 1) + (sch - gb - 231 - cym) * clamp(ey + fh - (gny - 1), 0, 1)
    //  Edit mode: the cells it takes are outlined, and a press on them takes the widget; it moves a whole cell at a time under the pointer, and keeps its place (the settings
    //  file is written for each cell it lands on). The zone stays where the press was while it is dragged, as a zone that moves itself would lose the drag.
    prop edp = 0 ~calm
    follow edp = if(edit, 1, 0)
    prop dgp = 0 ~quick
    follow dgp = if(dragging, 1, 0)
    //  The outline hugs what is drawn (the card's content is 340 wide, from 30, and about 210 tall, from 8, with a little margin round it), not the cells it takes.
    let ox = 18
    let oy = -2
    //  Where the card is on its monitor, for the window manager's scene (it keeps a hole in its desktop-click zone there; see logic/desk_holes.luau in the shell).
    fact hx = 0
    fact hy = 0
    fact hw = 0
    fact hh = 0
    on change cx0 { hx = cx0 + 18 }
    on change cy0 { hy = cy0 - 2; hw = 364; hh = 230 }
    let ow = 364
    let oh = 230
    let zx = if(dragging, zpx, cx0) + ox
    let zy = if(dragging, zpy, cy0) + oy
    //  The cell under the dragged card, unclamped: past the grid's edge by most of a cell, against an edge with a monitor behind it, it is being pushed
    //  over there (`es`; the logic sends it once it has been held there a moment). A drag never leaves this surface: pleamar keeps it until release.
    let rawx = (dcx - gl) / gw - fw / 2
    let rawy = (dcy - gt) / gh - fh / 2
    let push = if(dragging, if(rawx < -0.75 and nb_l, 1, if(rawx > gnx - fw + 0.75 and nb_r, 2, if(rawy < -0.75 and nb_t, 3, if(rawy > gny - fh + 0.75 and nb_b, 4, 0)))), 0)
    on change push { es = push }
    //  Come in from another monitor, it is put against the edge it came in by (the logic says `gx` or `gy` 99): the last cell it fits in here.
    on change gx while gx > gnx - fw { gx = gnx - fw }
    on change gy while gy > gny - fh { gy = gny - fh }
    on change fw while gx > gnx - fw { gx = gnx - fw }
    on change fh while gy > gny - fh { gy = gny - fh }
    //  (Only while the drag is this monitor's: once it has gone over, the button is still down and the drag goes on reaching the zone, now on the other
    //  monitor, until it is let go.)
    on change dcx while dragging { gx = clamp(floor(rawx + 0.5), 0, gnx - fw); gy = clamp(floor(rawy + 0.5), 0, gny - fh) }
    on change dcy while dragging { gx = clamp(floor(rawx + 0.5), 0, gnx - fw); gy = clamp(floor(rawy + 0.5), 0, gny - fh) }

    let ry = 92
    surface face {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: scr; reserve: -1; rate: 60, 15 while not edit and not glide
        //  (15 frames a second at rest: the graph glides on a 4 s spring after every sample, so it never stops, and at the screen's pace that was a full-screen layer
        //  painted sixty times a second all day. Smooth enough for a graph; full pace while it is dragged or put back.)
        //  While it is dragged the zone is the whole surface (a zone that moved with the card would lose the drag).
        zone box edz { from: if(dragging, 0, zx), if(dragging, 0, zy); size: if(dragging, scw, ow), if(dragging, sch, oh); corner: 16; cursor: pointer; active: edit and shown; label: "Move system" }
        on press edz { pcx = gl + (ex0 + fw / 2) * gw; pcy = gt + (ey0 + fh / 2) * gh; dcx = pcx; dcy = pcy; zpx = cx0; zpy = cy0; dragging = true }
        on drag edz { dcx = if(dragging, pcx + drag.dx, dcx); dcy = if(dragging, pcy + drag.dy, dcy) }
        //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
        //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
        on press right edz { }
        //  Once more, now that it is still (the rules above read the frame before); not when it has just gone over to another monitor (`dragging` is false
        //  then: the logic has put it at the edge it came in by, and this release comes from the drag on the monitor it left).
        on release edz { gx = if(dragging, clamp(floor(rawx + 0.5), 0, gnx - fw), gx); gy = if(dragging, clamp(floor(rawy + 0.5), 0, gny - fh), gy); dragging = false; es = 0 }
        group {
            show: edp > 0.01 and shown
            opacity: edp
            box { from: cx0 + ox, cy0 + oy; size: ow, oh; corner: 16; color: mint; opacity: 7% + 9% * dgp }
            box { from: cx0 + ox, cy0 + oy; size: ow, oh; corner: 16; stroke: 1.6; color: mint; opacity: 55% + 45% * dgp }
            text "System" { at: cx0 + ox + 14, cy0 + oy + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
        }
        //  Pushed against an edge with a monitor behind it: that edge lights up and names the monitor it is going to.
        group {
            show: push > 0
            box { from: 0, 0; size: 6, sch; color: mint; opacity: 70%; show: push == 1 }
            box { from: scw - 6, 0; size: 6, sch; color: mint; opacity: 70%; show: push == 2 }
            box { from: 0, 0; size: scw, 6; color: mint; opacity: 70%; show: push == 3 }
            box { from: 0, sch - 6; size: scw, 6; color: mint; opacity: 70%; show: push == 4 }
            text nbn_l { at: 24, sch / 2; anchor: left center; size: 16; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 6, 80%; show: push == 1 }
            text nbn_r { at: scw - 24, sch / 2; anchor: right center; size: 16; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 6, 80%; show: push == 2 }
            text nbn_t { at: scw / 2, 28; anchor: center; size: 16; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 6, 80%; show: push == 3 }
            text nbn_b { at: scw / 2, sch - 28; anchor: center; size: 16; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 6, 80%; show: push == 4 }
        }
        group {
            move: cx0, cy0
            show: sh > 0.01
            body {
                color: tint
                glass: 1
                lens: false
                rim: 70%
                shine: 0, 0
                shadow: 0, 6, 18, 30%
                opacity: sh * clr * (1 - ob)
                show: ob < 0.996
                arc { at: g0, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
                arc { at: g1, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
                arc { at: g2, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg; show: gpu_on }
                box { at: 200, 206; size: 340, 2.4; corner: 1.2 }
            }
            //  Retro and UwU: the card itself, a plastic plate with an outline and a hard shadow (the tracks and the graph's line are cut into it, below).
            body {
                color: tint
                rim: 0%
                border: (2 + 1.2 * uk - 0.8 * ppk - 0.6 * pxk + 2.2 * dd) * (1 - mk) * pl, mix(mix(mix(deep, tint, 0.55 * ppk), mix(#e8f1f5, tint, 0.4), pxk), ink, dd)
                shadow: (4 - 2.5 * ppk - mk - 1.5 * pxk) * pl, (5 - 1.5 * ppk - mk - 2 * pxk) * pl, 9 * ppk + 10 * mk, (55% - 13% * ppk - 27% * mk + 30% * pxk + 35% * uk) * (1 - dd), mix(deep, #ff6ec7, 0.75 * uk)
                opacity: sh * pl
                show: pl > 0.004
                box { at: 200, 113; size: 364, 230; corner: 16 }
            }
            //  Milkbox: the white light of the raised plate (the dark shade is the plate's own shadow, above).
            body {
                color: tint
                rim: 0%
                shadow: -3 * mk, -3 * mk, 8 * mk, 38% * mk, #ffffff
                opacity: sh * mk
                show: mk > 0.004
                box { at: 200, 113; size: 364, 230; corner: 16 }
            }
            //  Paper: the worn, torn edge and two strips of tape.
            group {
                show: ppk > 0.01
                opacity: sh * ppk
                shader paper { at: (200 - 364 / 2) - 8, (113 - 230 / 2) - 8; size: 364 + 16, 230 + 16; values: 1, 3.7, 8, 16; colors: tint, deep }
                box { at: (200 - 364 / 2) + 30, (113 - 230 / 2) + -2; size: 60, 19; rotate: -11deg; color: #e9dba8; opacity: 86% }
                box { at: (200 - 364 / 2) + 30, (113 - 230 / 2) + -2; size: 60, 19; rotate: -11deg; stroke: 1; color: deep; opacity: 22% }
                box { at: (200 - 364 / 2) + 364 - 58, (113 - 230 / 2) + 4; size: 70, 19; rotate: 3deg; color: #c9d8ec; opacity: 86% }
                box { at: (200 - 364 / 2) + 364 - 58, (113 - 230 / 2) + 4; size: 70, 19; rotate: 3deg; stroke: 1; color: deep; opacity: 22% }
            }
            //  Obsidian (Vitreus has its glass off): the same shapes as a flat, dark piece.
            body {
                color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), off, pl)
                rim: 0%
                opacity: sh * ob
                shadow: 0, 6, 18, 45% * (1 - pl), #000000
                show: ob > 0.004
                arc { at: g0, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
                arc { at: g1, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg }
                arc { at: g2, ry; radius: 36; span: 270deg; width: 8; rotate: 0deg; show: gpu_on }
                box { at: 200, 206; size: 340, 2.4; corner: 1.2 }
            }
            group {
                opacity: sh
                text host { at: 30, 30; anchor: left center; size: 17; weight: 700; width: 190; lines: 1; color: tx; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
                text up { at: 370, 30; anchor: right center; size: 13; weight: 600; width: 120; lines: 1; color: tx; family: "Space Grotesk"; align: right; opacity: 80%; shadow: 0, 1, 5, 70% * (1 - pl) }
                text aur_txt { at: 212, 30; anchor: center center; size: 12; weight: 600; width: 150; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk"; align: center; show: aur_on; shadow: 0, 1, 5, 70% * (1 - pl) }

                group {
                    glow: 7, 26% * (1 - pl)
                    arc { at: g0, ry; radius: 36; span: (270 * clamp(cpu_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((cpu_p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(cpu_p, 0.004, 1)) * 1deg }
                    arc { at: g1, ry; radius: 36; span: (270 * clamp(mem_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((mem_p - 0.85) / 0.15, 0, 1)); rotate: (-135 + 135 * clamp(mem_p, 0.004, 1)) * 1deg }
                    arc { at: g2, ry; radius: 36; span: (270 * clamp(gpu_p, 0.004, 1)) * 1deg; width: 8; color: mix(mint, alert, clamp((gpu_p - 0.85) / 0.15, 0, 1)); rotate: (-135 + 135 * clamp(gpu_p, 0.004, 1)) * 1deg; show: gpu_on }
                }
                text cpu_txt { at: g0, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: tx; family: "Space Grotesk"; align: center; shadow: 0, 1, 6, 70% * (1 - pl) }
                text "CPU" { at: g0, ry + 13; anchor: center center; size: 10; weight: 700; color: tx; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
                text cpu_meta { at: g0, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: tx; opacity: 85%; family: "Space Grotesk"; align: center; shadow: 0, 1, 5, 70% * (1 - pl) }
                text mem_txt { at: g1, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: tx; family: "Space Grotesk"; align: center; shadow: 0, 1, 6, 70% * (1 - pl) }
                text "MEMORY" { at: g1, ry + 13; anchor: center center; size: 10; weight: 700; color: tx; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
                text mem_meta { at: g1, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: tx; opacity: 85%; family: "Space Grotesk"; align: center; shadow: 0, 1, 5, 70% * (1 - pl) }
                text gpu_txt { at: g2, ry - 4; anchor: center center; size: 20; weight: 700; width: 60; lines: 1; color: tx; family: "Space Grotesk"; align: center; show: gpu_on; shadow: 0, 1, 6, 70% * (1 - pl) }
                text "GRAPHICS" { at: g2, ry + 13; anchor: center center; size: 10; weight: 700; color: tx; opacity: 75%; family: "Space Grotesk"; show: gpu_on; shadow: 0, 1, 5, 70% * (1 - pl) }
                text gpu_meta { at: g2, 146; anchor: center center; size: 11.5; weight: 600; width: 112; lines: 1; color: tx; opacity: 85%; family: "Space Grotesk"; align: center; show: gpu_on; shadow: 0, 1, 5, 70% * (1 - pl) }

                text "NETWORK" { at: 30, 172; anchor: left center; size: 11; weight: 700; color: tx; opacity: 75%; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
                text rx_txt { at: 140, 172; anchor: left center; size: 12.5; weight: 700; width: 112; lines: 1; color: tx; family: "Space Grotesk"; shadow: 0, 1, 5, 70% * (1 - pl) }
                text tx_txt { at: 370, 172; anchor: right center; size: 12.5; weight: 700; width: 112; lines: 1; color: mix(mint, tx, 0.4); family: "Space Grotesk"; align: right; shadow: 0, 1, 5, 70% * (1 - pl) }
                //  The columns are close enough (and smoothed in the logic) to read as one curve; the whole graph slides left as each sample arrives.
                //  It slides continuously (`net_glide`), and the newest sample comes in from beyond the edge (clipped), so it never pops in. (Not rounded to
                //  part of a pixel to paint less often: at under 6 px a second that showed as steps.)
                group {
                    clip box { at: 200, 206; size: 344, 80 }
                    group {
                        move: (clamp(net_lag, 0, 4) - 1) * 5.67, 0
                        repeat i in 0..120 {
                            let k = i + 120 - net_h.count
                            let dh = max(1.2, clamp(net_h.$i.rx, 0, 1) * 26)
                            let uh = max(1.2, clamp(net_h.$i.tx, 0, 1) * 22)
                            box { at: 31.4 + (k + 0.5) * 2.835, 205 - dh / 2; size: 2.6, dh; corner: 1.2; color: mint; opacity: (25% + 70% * k / 120); show: i < net_h.count }
                            box { at: 31.4 + (k + 0.5) * 2.835, 208 + uh / 2; size: 2.6, uh; corner: 1.2; color: mix(mint, tx, 0.4); opacity: (20% + 55% * k / 120); show: i < net_h.count }
                        }
                    }
                }
            }
        }
    }
}
