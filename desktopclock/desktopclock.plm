language 0.1
// vitreus-fonts: lean   (it draws only in "Space Grotesk": bin/vitreus-keep starts it without the system's other fonts, see bin/vitreus-fonts)
import "../palette-live.plm"
import "clockface.plm"
import "clockface_styled.plm"

//  The desktop clock: the time in digits drawn as glass, on the bottom layer (above the wallpaper, under every window).
//  Each digit is a single stroke (clockface.plm), and all of them are one body of glass: the light runs round their edges and the compositor
//  blurs what is behind them. Its tint is the shell's (`tint` of palette.plm, which Iris keeps), the same as the bar's glass.
//
//  Turn it on or off with   pleamar --say desktopclock "fact shown true"   (or false); Settings > Clock has the switch and the rest.
//  Its settings are kept in desktopclock.json, in ~/.local/share/pleamar/desktopclock (see desktopclock.luau).

scene DesktopClock {
    //  1 x 1 and empty, one on each monitor: its copies report the monitors' names (`screen.K.name`) for where `hyprctl` does not answer, and keep the
    //  scene's rules running. The clock itself is `surface face` below: one surface, on its own monitor (`scr`), not a full-screen copy on every
    //  monitor (~27 MB on the card each, drawing nothing but on one of them). See widget_place.luau.
    surface { size: 1, 1; anchor: top_left; margin: 0; level: background; screens: each max 4; reserve: -1; keyboard: none }

    permissions { services: "clock", "files", "files.write"; run: "pleamar", "hyprctl", "socat", "printenv", "vitreus-btnwait" }

    //  The shell's colours as facts (palette-live.plm reads them): Vitreus sets them when the palette changes (`push_pal` in vitreus.luau), so the theme
    //  changes the colour at once, not after a reload of this scene as the imported palette.plm did.
    fact pal_ink_r = 0.9608   // #f5f7f5
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608   // #c2c7cc
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196   // #9ed6bd
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235   // #6cbc9c
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627   // #dcf8ec
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627   // #10161a
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059   // #1b2127
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863   // #161a1f
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431   // #0b0e11
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275   // #3a4048
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373   // #ef4444
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    service clock as now { hour: number }

    fact where: top_left | top | top_right | left | center | right | bottom_left | bottom | bottom_right = center
    fact gx = -1           // the cell of its top left corner, 0 to 15 (-1: not chosen yet, `where` says)
    fact gy = -1           // and the row, 0 to 8
    fact edit = false      // Edit, from the desktop editor (desktopedit/): the widget shows the cells it takes and can be dragged to others
    fact g0x = 0           // while it is dragged: the cell it was at when it was pressed
    fact g0y = 0
    fact dragging = false
    text mon_name = ""     // the name of the monitor that shows the card (Settings > Widgets sets it; the logic keeps it)
    text scr = ""          // the monitor its surface is on: the logic sets it (widget_place.luau), the same as `mon_name` once the monitors are known
    //  Whether there is a monitor behind each edge of its own (the logic works it out), and its name: in Edit mode the widget goes over to it when it
    //  is pushed against that edge and held there a moment (`es`, which the logic watches).
    fact nb_l = false
    fact nb_r = false
    fact nb_t = false
    fact nb_b = false
    text nbn_l = ""
    text nbn_r = ""
    text nbn_t = ""
    text nbn_b = ""
    fact es = 0            // while it is dragged: the edge it is over that has a monitor behind it, 1 left, 2 right, 3 top, 4 bottom, 0 none (the logic puts `ghost` there)
    text gscr = ""         // the monitor `ghost` is on, while part of the dragged face is over it (the logic)
    fact gox = 0           // how far that monitor is from this one, in the desktop's pixels (the logic)
    fact goy = 0
    fact land = 0          // let go at an edge with a monitor behind it (or with its middle over there): which edge (it slides over, and the logic moves it there)
    fact sliding = false   // sliding over to that monitor: from where it was let go (`sx0`, `sy0`) to its place by the edge it comes in at, in ~0.3 s
    fact sx0 = 0
    fact sy0 = 0
    fact st0 = 0           // `time` when the slide began
    prop time = 0
    spin time by if(sliding, 1, 0)       // (the clock runs only while it slides)
    fact ppx = 0           // while it is dragged: the pointer where it was pressed, and where the drag has it now (on this surface)
    fact ppy = 0
    fact pxn = 0
    fact pyn = 0
    fact pxp = 0           // and where the drag had it the time before (how fast it goes: a quick one crosses an edge between two of them)
    fact pyp = 0
    fact landed = false    // just sent there: `ghost` still shows it until its own surface is up on that monitor (the logic, a moment)
    //  Carried over: with a mouse the drag ends at the monitor's edge (the compositor lets go of it there), so from then on the face follows the pointer
    //  by itself, on whichever of `face` and `ghost` it is over (`cs`: 1 or 2; `cpx`, `cpy` there), until the logic hears the button come up
    //  (bin/vitreus-btnwait) and puts it in the cell under it (`fgx`, `fgy`, which the scene keeps for it), on that monitor.
    fact carry = false
    fact cs = 1
    fact cpx = 0
    fact cpy = 0
    fact kx = 0            // from the pointer to the middle of the face, when it was pressed
    fact ky = 0
    fact fgx = 0
    fact fgy = 0
    fact nocarry = false   // the button cannot be heard (no access to the input devices): it slides over to the edge instead (the logic says so)
    //  A surface that has just been put on a monitor fades in (the compositor's own animation of a layer that appears), and one taken off fades out: so
    //  nothing is drawn on one until it has been there a moment (`fready` for `face`, `gready` for `ghost`; the logic), and one is taken off only once
    //  it draws nothing. That was the flicker when the widget went over.
    fact fready = true
    fact gready = false
    fact dfx = 0           // while it is dragged: from the middle of its cells to the middle of the face (the face follows the pointer, the cells come after)
    fact dfy = 0
    fact jump = false      // just gone over to another monitor: drawn at its new cell at once, not slid there by the cells' spring (the logic, a moment)
    prop jp = 0 ~0ms
    follow jp = if(jump, 1, 0)
    fact orphan = false    // its monitor is not plugged in: it is shown only in Edit mode, on the first monitor, marked (the logic)
    text orph = ""         // and that monitor's name
    fact pcx = 0           // while it is dragged: the face's centre when it was pressed, in its surface
    fact pcy = 0
    fact dcx = 0           // and where that centre is now
    fact dcy = 0
    fact zpx = 0           // while it is dragged: where the middle of the face was when it was pressed (the zone stays there)
    fact zpy = 0
    fact shown = false     // the logic sets it from desktopclock.json (so that `sh` follows it from nothing)
    fact lay = 0           // 0 pipe, 1 rule, 2 tower, 3 digital, 4 slash, 5 hero (see clockface.plm)
    fact h12 = true        // a 12 hour clock (the logic turns it into the digits); the Settings page reads it
    fact d0 = -1           // the digits shown: -1 for none (the hour's tens, with a 12 hour clock, when the hour is below 10)
    fact d1 = 0
    fact d2 = 0
    fact d3 = 0
    fact px = 220          // the digits' height in pixels
    fact wti = 1           // the strokes: 0 thin, 1 regular, 2 bold
    fact cli = 1           // the glass: 0 clear, 1 soft, 2 full

    //  The style of the hours, the minutes and the divider (see clockface_styled.plm): a weight and a size (multipliers; 1 is the normal) and a tint (0 the glass, 1 mint, 2 light, 3 rose, 4 grey)
    fact ghw = 1
    fact ghz = 1
    fact ghc = 0
    fact gmw = 1
    fact gmz = 1
    fact gmc = 0
    fact gsw = 1
    fact gsz = 1
    fact gsc = 0
    fact greset = 0          // set to 1 by Settings: every glyph back to the normal style (the logic puts it back to 0)
    text gpack = ""          // all of them in one line, for the Settings page to read at once: "w,z,c;" for the hours, the minutes and the divider

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    fact obs = false        // Vitreus has its glass off: the digits are flat obsidian (Vitreus says so with `fact obs true`)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    fact look = 0           // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; the last three draw the digits as plastic, like the bar (outline, hard shadow)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2 or look == 4 or look == 5 or look == 6 or look == 7, 1, 0)
    prop dd = 0 ~calm
    follow dd = if(look == 7, 1, 0)         // Doodle: pastel digits, a thick black outline, no hard shadow
    prop mk = 0 ~calm
    follow mk = if(look == 4, 1, 0)
    prop pxk = 0 ~calm
    follow pxk = if(look == 5, 1, 0)
    prop cy = 0 ~calm
    follow cy = if(look == 3, 1, 0)         // Cyber: the digits are filled with the neon (the glass's own tint is near-black there)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)

    let k = px / 88
    let wt = if(wti == 0, 0.62, if(wti == 2, 1.4, 1))
    let clr = if(cli == 0, 55%, if(cli == 1, 80%, 100%))
    //  Where the middle of the face is, in the surface: the middle of it, or against the edge or corner it sits in (half the face, and its stroke).
    //  What the style of the parts adds to the face (the same sums as in clockface_styled.plm and in the Settings page): how far each part grows past its normal size, so that
    //  the cells the clock takes (and the outline of them in Edit mode) hold all of it and not only the normal face.
    let pm1 = if(lay == 2, 0.6, 1)
    let pm2 = if(lay == 2, 0.6, if(lay == 5, 0.5, 1))
    let ugeh = max(0, 1.4 * pm1 * (ghz * (23 + 6.5 * wt * ghw) - (23 + 6.5 * wt)))
    let ugev = max(0, 1.4 * pm1 * (ghz * (44 + 6.5 * wt * ghw) - (44 + 6.5 * wt)))
    let umeh = max(0, 1.4 * pm2 * (gmz * (23 + 6.5 * wt * gmw) - (23 + 6.5 * wt)))
    let umev = max(0, 1.4 * pm2 * (gmz * (44 + 6.5 * wt * gmw) - (44 + 6.5 * wt)))
    let udv = max(0, 4.2 * wt * (gsw * gsz - 1))
    let udc = max(0, 9.8 * wt * (gsw * gsz - 1))
    let hw = (if(lay == 0, 149, if(lay == 1 or lay == 5, 61, if(lay == 2, 31, if(lay == 3, 152, 130)))) + 6.5 * wt + 2 * max(ugeh, umeh) + 1.5 * max(udv, udc)) * k
    let hh = (if(lay == 0, 59, if(lay == 1, 111, if(lay == 2, 131, if(lay == 3, 44, if(lay == 4, 112, 84))))) + 6.5 * wt + 2.2 * max(ugev, umev) + 1.5 * udv) * k
    let isl = if(where == top_left or where == left or where == bottom_left, 1, 0)
    let isr = if(where == top_right or where == right or where == bottom_right, 1, 0)
    let ist = if(where == top_left or where == top or where == top_right, 1, 0)
    let isb = if(where == bottom_left or where == bottom or where == bottom_right, 1, 0)
    //  The desktop is a grid of 16 columns and 9 rows, inside a 40 px margin; the settings put a widget on it by the cell of its top left corner (`gx`, `gy`) and it
    //  takes as many cells as it needs (`cfw`, `cfh`, which Settings > Widgets asks for). Against an edge of the grid it sits against that edge, between them it is centred in its cells.
    //  `gx` and `gy` below 0 are an older settings file: it is put where `where` says (one of the nine places, which is what the cells are made of).
    //  The room the bar's frame takes round the screen (Vitreus tells it: `room_*`, in pixels, 0 when the bar is not a frame), which the grid stays out of, so a widget cannot be put under the bar.
    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    let gnx = 28           // the grid: 28 columns and 16 rows (it used to be 16 x 9), from the bar's frame (the `room_*`) plus a 16 px margin
    let gny = 16
    let gm = 16
    let gl = gm + room_l
    let gt = gm + room_t
    let gr = gm + room_r
    let gb = gm + room_b
    let scw = face.width       // what its monitor measures (its surface is the whole of it)
    let sch = face.height
    let gw = (scw - gl - gr) / gnx
    let gh = (sch - gt - gb) / gny
    let fw = clamp(ceil(2 * hw / gw), 1, gnx)
    let fh = clamp(ceil(2 * hh / gh), 1, gny)
    let ex0 = clamp(if(gx < 0, if(isl > 0.5, 0, if(isr > 0.5, gnx - fw, (gnx - fw) / 2)), gx), 0, gnx - fw)
    let ey0 = clamp(if(gy < 0, if(ist > 0.5, 0, if(isb > 0.5, gny - fh, (gny - fh) / 2)), gy), 0, gny - fh)
    //  In Edit mode what is drawn follows the cell with a spring (`erx`, `ery`); otherwise it is the cell.
    prop erx = 0 ~quick
    prop ery = 0 ~quick
    follow erx = if(gx < 0, ex0, gx)      // (`ex` clamps it to what fits)
    //  Settings > Theme > Pin widgets: while a theme puts the widgets back (`glide`, said by Vitreus), what is drawn slides to its new cell on a slower
    //  spring instead of jumping to it.
    fact glide = false
    prop glp = 0 ~0ms                    // (at once: the slower spring is already where the widget is, so taking it over shows nothing)
    follow glp = if(glide, 1, 0)
    prop gsx = 0 ~gentle
    prop gsy = 0 ~gentle
    follow gsx = if(gx < 0, ex0, gx)
    follow gsy = if(gy < 0, ey0, gy)
    follow ery = if(gy < 0, ey0, gy)
    let ex = clamp(mix(mix(mix(ex0, erx, edp), gsx, glp), if(gx < 0, ex0, gx), jp), 0, gnx - fw)
    let ey = clamp(mix(mix(mix(ey0, ery, edp), gsy, glp), if(gy < 0, ey0, gy), jp), 0, gny - fh)
    //  Against the grid's edge the face is against the edge, between them it is in the middle of its cells, and in between it moves from one to the other (so that it never jumps).
    let cxm = gl + (ex + fw / 2) * gw
    let cym = gt + (ey + fh / 2) * gh
    let fx = cxm + (gl + hw + 13 - cxm) * clamp(1 - ex, 0, 1) + (scw - gr - hw - 13 - cxm) * clamp(ex + fw - (gnx - 1), 0, 1)
    let fy = cym + (gt + hh + 13 - cym) * clamp(1 - ey, 0, 1) + (sch - gb - hh - 13 - cym) * clamp(ey + fh - (gny - 1), 0, 1)
    //  Edit mode: the cells it takes are outlined, and a press on them takes the widget; it moves a whole cell at a time under the pointer, and keeps its place (the settings
    //  file is written for each cell it lands on). The zone stays where the press was while it is dragged, as a zone that moves itself would lose the drag.
    prop edp = 0 ~calm
    follow edp = if(edit, 1, 0)
    prop dgp = 0 ~quick
    follow dgp = if(dragging, 1, 0)
    //  The outline hugs the face (a little margin round it) instead of the cells it takes, and the face is in the middle of it.
    let pad = 10
    //  Where the face is on its monitor, for the window manager's scene (it keeps a hole in its desktop-click zone there; see logic/desk_holes.luau in the shell).
    fact hl_x = 0
    fact hl_y = 0
    fact hl_w = 0
    fact hl_h = 0
    on change fx { hl_x = fx - hw - pad }
    on change fy { hl_y = fy - hh - pad }
    on change hw { hl_w = 2 * (hw + pad); hl_x = fx - hw - pad }
    on change hh { hl_h = 2 * (hh + pad); hl_y = fy - hh - pad }
    let zx = if(dragging, zpx, fx) - hw - pad
    let zy = if(dragging, zpy, fy) - hh - pad
    //  While it is dragged the face follows the pointer (`fxa`, `fya`), and the cells it would take follow under it; let go, it settles into them.
    //  Where it comes to rest over there, in this surface's coordinates (`gox`, `goy`: how far that monitor is): against the edge it came in by, at the same row
    //  (or column), as `fx` and `fy` put a face at the first or the last cell (only when it slides over: see `nocarry`).
    let tgx = if(land == 2, gox + gl + hw + 13, if(land == 1, gox + ghost.width - gr - hw - 13, fx + gox))
    let tgy = if(land == 4, goy + gt + hh + 13, if(land == 3, goy + ghost.height - gb - hh - 13, fy + goy))
    let stw = clamp((time - st0) / 0.3, 0, 1)
    let ste = 1 - (1 - stw) * (1 - stw) * (1 - stw)
    //  Carried: under the pointer, on the surface it is over, in this surface's coordinates.
    let cfx = if(cs == 2, cpx + kx + gox, cpx + kx)
    let cfy = if(cs == 2, cpy + ky + goy, cpy + ky)
    let fxa = if(dragging, dcx + dfx, if(carry, cfx, if(sliding, mix(sx0, tgx, ste), fx)))
    let fya = if(dragging, dcy + dfy, if(carry, cfy, if(sliding, mix(sy0, tgy, ste), fy)))
    let rawx = (dcx - gl) / gw - fw / 2
    let rawy = (dcy - gt) / gh - fh / 2
    //  Part of it over an edge with a monitor behind it (`near`): the logic puts the surface `ghost` on that monitor (`gscr`, `gox`, `goy`), which draws
    //  the part that is over there, so it slides across. The drag stays this surface's own the whole time (a drag is lost with the surface that took the
    //  press: moving `face` while dragging ended it). Let go with the face's middle over there (`cross`), it lands there (`land`).
    let near = if(dragging, if(fxa - hw < 0 and nb_l, 1, if(fxa + hw > scw and nb_r, 2, if(fya - hh < 0 and nb_t, 3, if(fya + hh > sch and nb_b, 4, 0)))), 0)
    on change near { es = near }
    let cross = if(fxa < 0 and nb_l, 1, if(fxa > scw and nb_r, 2, if(fya < 0 and nb_t, 3, if(fya > sch and nb_b, 4, 0))))
    //  The pointer against an edge with a monitor behind it, when the drag ends: with a mouse the drag ends there anyway (the compositor lets go of it as the
    //  pointer goes on to the other monitor, and this scene is not told when the button is let go there), so reaching the edge is what sends it over.
    //  Near the edge (48 px), or going fast enough for its next step to be past it.
    let pxf = pxn + (pxn - pxp)
    let pyf = pyn + (pyn - pyp)
    let tch = if((pxn >= scw - 48 or pxf >= scw) and nb_r, 2, if((pxn <= 48 or pxf <= 0) and nb_l, 1, if((pyn <= 48 or pyf <= 0) and nb_t, 3, if((pyn >= sch - 48 or pyf >= sch) and nb_b, 4, 0))))
    let goside = if(cross > 0, cross, tch)
    //  Let go with the pointer past this monitor's edge: the drag went on over there (it does while `ghost` is already on that monitor, as it is from the
    //  press), so it is let go over the other monitor, in `ghost`'s coordinates there.
    let outp = if(pxn >= scw or pxn < 0 or pyn >= sch or pyn < 0, 1, 0)
    //  The cell under the carried face (from the middle of its cells, `dfx` away), on the monitor it is over: that one's grid (`ghost` measures it) or this one's.
    let ngw = (ghost.width - gl - gr) / gnx
    let ngh = (ghost.height - gt - gb) / gny
    let nfw = clamp(ceil(2 * hw / ngw), 1, gnx)
    let nfh = clamp(ceil(2 * hh / ngh), 1, gny)
    let dgx = if(cs == 2, clamp(floor((cfx - gox - dfx - gl) / ngw - nfw / 2 + 0.5), 0, gnx - nfw), clamp(floor((cfx - dfx - gl) / gw - fw / 2 + 0.5), 0, gnx - fw))
    let dgy = if(cs == 2, clamp(floor((cfy - goy - dfy - gt) / ngh - nfh / 2 + 0.5), 0, gny - nfh), clamp(floor((cfy - dfy - gt) / gh - fh / 2 + 0.5), 0, gny - fh))
    on change dgx while carry { fgx = dgx }
    on change dgy while carry { fgy = dgy }
    on change carry while carry { fgx = dgx; fgy = dgy }
    on change pointer.x while carry { cpx = pointer.x }
    on change pointer.y while carry { cpy = pointer.y }
    //  No way to hear the button (the logic says `nocarry`): from where it is, it slides over to the edge it was carried over, as it did before.
    on change nocarry while nocarry { sx0 = fxa; sy0 = fya; st0 = time; sliding = true; carry = false; nocarry = false }
    //  Come in from another monitor, it is put inside the grid: the last cell it fits in here.
    on change gx while gx > gnx - fw { gx = gnx - fw }
    on change gy while gy > gny - fh { gy = gny - fh }
    on change fw while gx > gnx - fw { gx = gnx - fw }
    on change fh while gy > gny - fh { gy = gny - fh }
    on change dcx while dragging { gx = clamp(floor(rawx + 0.5), 0, gnx - fw); gy = clamp(floor(rawy + 0.5), 0, gny - fh) }
    on change dcy while dragging { gx = clamp(floor(rawx + 0.5), 0, gnx - fw); gy = clamp(floor(rawy + 0.5), 0, gny - fh) }

    surface face {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: scr; reserve: -1
        //  While it is dragged the zone is the whole surface (a zone that moved with the card would lose the drag); pleamar keeps the drag going past its edge.
        zone box edz { from: if(dragging or carry, 0, zx), if(dragging or carry, 0, zy); size: if(dragging or carry, scw, 2 * (hw + pad)), if(dragging or carry, sch, 2 * (hh + pad)); corner: 16; cursor: pointer; active: edit and shown; label: "Move clock" }
        on enter edz { cs = if(carry, 1, cs); cpx = if(carry, pointer.x, cpx); cpy = if(carry, pointer.y, cpy) }
        on press edz { kx = fx - pointer.x; ky = fy - pointer.y; cs = 1; ppx = pointer.x; ppy = pointer.y; pxn = pointer.x; pyn = pointer.y; pxp = pointer.x; pyp = pointer.y; pcx = gl + (ex0 + fw / 2) * gw; pcy = gt + (ey0 + fh / 2) * gh; dcx = pcx; dcy = pcy; dfx = fx - pcx; dfy = fy - pcy; zpx = fx; zpy = fy; dragging = true }
        on drag edz { dcx = if(dragging, pcx + drag.dx, dcx); dcy = if(dragging, pcy + drag.dy, dcy); pxp = pxn; pyp = pyn; pxn = if(dragging, ppx + drag.dx, pxn); pyn = if(dragging, ppy + drag.dy, pyn) }
        //  A right click does nothing here, on purpose: a scene that never names the right button is closed by one (pleamar's way out of a prototype with no
        //  keyboard), and the keeper starts it again a moment later, out of Edit mode: the widget went away and came back stuck.
        on press right edz { }
        //  Let go: into the cell under it here. Over the other monitor, or at the edge (`goside`): `carry` and `land` tell the logic, which listens for the
        //  button. Let go over there (`outp`), the button is already up: it goes into the cell under it there. At the edge, the drag may have ended because the
        //  compositor let go of it as the pointer went on over there: it is carried on from there, under the pointer, until the button comes up.
        on release edz { gx = if(dragging and goside == 0, clamp(floor(rawx + 0.5), 0, gnx - fw), gx); gy = if(dragging and goside == 0, clamp(floor(rawy + 0.5), 0, gny - fh), gy); cpx = if(outp > 0.5, pxn - gox, pxn); cpy = if(outp > 0.5, pyn - goy, pyn); cs = if(outp > 0.5, 2, 1); carry = if(dragging, goside > 0, carry); land = if(dragging, goside, 0); dragging = false; es = 0 }
        group {
            show: fready
            group {
                show: edp > 0.01 and shown
                opacity: edp
                box { from: fxa - hw - pad, fya - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; color: mint; opacity: 7% + 9% * dgp }
                box { from: fxa - hw - pad, fya - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; stroke: 1.6; color: mint; opacity: 55% + 45% * dgp }
                text "Clock" { at: fxa - hw - pad + 14, fya - hh - pad + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
                //  (its monitor is not plugged in: shown here only in Edit mode, to be placed)
                text orph { at: fxa + hw + pad - 14, fya - hh - pad + 16; anchor: right center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70%; show: orphan }
            }
            //  Over an edge with a monitor behind it: that edge glows faintly, where it goes over.
            group {
                show: near > 0
                box { from: 0, 0; size: 4, sch; color: mint; opacity: 45%; show: near == 1 }
                box { from: scw - 4, 0; size: 4, sch; color: mint; opacity: 45%; show: near == 2 }
                box { from: 0, 0; size: scw, 4; color: mint; opacity: 45%; show: near == 3 }
                box { from: 0, sch - 4; size: scw, 4; color: mint; opacity: 45%; show: near == 4 }
            }
            group {
                ClockFaceStyled(k, lay, d0, d1, d2, d3, fxa, fya, mix(tint, mint, cy), 1, 0.4, sh * clr, wt, mint, ink, alert, faint, ob, pl, uk, deep, mk, pxk, dd)
            }
        }
    }

    //  The monitor next door, while the dragged face is partly over it, and for a moment after it has landed there (until `face` is up on it).
    //  Before it lands it draws the face where the drag has it, less how far that monitor is (`gox`, `goy`); after, where `face` will.
    let gfx = if(dragging or carry or sliding, fxa - gox, fx)
    let gfy = if(dragging or carry or sliding, fya - goy, fy)
    surface ghost {
        size: full, full; anchor: top_left; margin: 0; level: bottom, top while edit; screens: gscr; reserve: -1; keyboard: none
        //  While it is carried over here this whole surface hears the pointer (where it is, `cpx`, `cpy`), so the face can follow it.
        zone box gz { from: 0, 0; size: ghost.width, ghost.height; cursor: pointer; active: carry }
        on enter gz { cs = if(carry, 2, cs); cpx = if(carry, pointer.x, cpx); cpy = if(carry, pointer.y, cpy) }
        on press right gz { }
        group {
            show: (dragging or carry or sliding or landed) and gready
            group {
                show: edp > 0.01 and shown
                opacity: edp
                box { from: gfx - hw - pad, gfy - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; color: mint; opacity: 7% + 9% * dgp }
                box { from: gfx - hw - pad, gfy - hh - pad; size: 2 * (hw + pad), 2 * (hh + pad); corner: 16; stroke: 1.6; color: mint; opacity: 55% + 45% * dgp }
                text "Clock" { at: gfx - hw - pad + 14, gfy - hh - pad + 16; anchor: left center; size: 12; weight: 700; color: mint; family: "Space Grotesk"; shadow: 0, 1, 5, 70% }
            }
            group {
                ClockFaceStyled(k, lay, d0, d1, d2, d3, gfx, gfy, mix(tint, mint, cy), 1, 0.4, sh * clr, wt, mint, ink, alert, faint, ob, pl, uk, deep, mk, pxk, dd)
            }
        }
    }
}
